%% Step 0: Initalize Workspace
close all % close figures and other stuff
clear % clean the worksapce
clc % clear command line

use_saved = true; % If false reprocess data

if use_saved && isfile('preprocessed_data.mat')
    fprintf('Loading preprocessed data...\n');
    load('preprocessed_data.mat');
else
    %% Step 1: Load Dataset for training
    train_pattern = fullfile('Images/train/','*.png');
    train_img_files = dir(train_pattern);

    train_num_images = numel(train_img_files);
    train_imgs = cell(1, train_num_images);

    for i = 1:train_num_images
        img_name = train_img_files(i).name;
        fullPath = fullfile('Images/train', img_name);
        raw_img = imread(fullPath);
        train_imgs{i} = im2double(raw_img);
    end

    %% Step 2: Preprocess Images
    n1 = 100; n2 = 100;
    for i = 1:train_num_images
        train_imgs{i} = PreprocessImage(train_imgs{i}, false); % Convert training images to greyscale, crop the image, and resize to 100 x 100
    end
    
    %% Step 3: Feature Extraction PCA & LDA
    fprintf("Gathering Unique Subject Names...\n");
    actor_names = cell(train_num_images,1);
    for i = 1:train_num_images % Gather names from images for labels
        name = train_img_files(i).name;
        tokens = regexp(name, '([a-z_]+)(\d+)\.png$', 'tokens');
        actor_names{i} = tokens{1}{1};
    end

    [unique_names, ~, labels] = unique(actor_names); % Save only one of each kind
    
    fprintf("Creating Image Matrix...\n");
    img_matrix = zeros(train_num_images, n1 * n2);
    for i = 1:train_num_images
        img_matrix(i, :) = train_imgs{i}(:);
    end
    
    % Generate and save PCA
    fprintf("Generating Eigenfaces...\n");
    K = 50;
    [mean_face, evecs_reduced, projected_data_pca, eigen_faces] = PCA_Eigenfaces(img_matrix, K); % Moved to function for consistancy and ease of reading
    
    fprintf("Saving PCA...\n");
    save('preprocessed_data.mat', 'projected_data_pca', 'labels', 'mean_face', 'evecs_reduced', 'unique_names', 'n1', 'n2');
    
    % Generate and save LDA
    fprintf("Computing LDA Directions...\n");
    lda_dirs = compute_LDA_directions(projected_data_pca, labels);
    projected_data_lda = projected_data_pca * lda_dirs;
    
    fprintf("Saving LDA...\n");
    save('preprocessed_data.mat', 'lda_dirs', 'projected_data_lda', '-append');
end

%% Step 5: Train Classifiers

% KNN Model PCA
fprintf("Fitting Models...\n");
knn_model_pca = fitcknn(projected_data_pca, labels, 'NumNeighbors', 3);

% Naive Bayes Model PCA
nb_model_pca = fitcnb(projected_data_pca, labels, 'DistributionNames', 'kernel');

% KNN Model PCA
knn_model_lda = fitcknn(projected_data_lda, labels, 'NumNeighbors',3);

% Naive Bayes Model PCA
nb_model_lda  = fitcnb(projected_data_lda, labels, 'DistributionNames','kernel');

%% —————————————— Step 6: Load & Preprocess Test Set
fprintf("Loading in Test Images...\n");
test_pattern    = fullfile('Images/test','*.png');
test_img_files  = dir(test_pattern);
num_test_images = numel(test_img_files);

% new: store the preprocessed images for display
test_imgs   = cell(1, num_test_images);
test_matrix = zeros(num_test_images, n1 * n2);
test_labels = zeros(num_test_images,1);

for i = 1:num_test_images
    raw = im2double(imread(fullfile('Images/test', test_img_files(i).name)));
    proc = PreprocessImage(raw, false);
    test_imgs{i} = proc;
    test_matrix(i,:) = proc(:)'; % Flatten into a matrix

    % Extract true label from file name
    tokens = regexp(test_img_files(i).name, '([a-z_]+)\d+\.png$', 'tokens');
    actor = tokens{1}{1};
    test_labels(i) = find(strcmp(unique_names, actor));
end

% Center test faces
test_centered = test_matrix - mean_face;
X_test = test_centered * evecs_reduced;
y_test = test_labels;

%% Step 7: Test Set Predictions
fprintf("Predicting with Test Images...\n");

% Project & Predict with PCA
[y_pred_knn_pca, scores_knn_pca] = predict(knn_model_pca, X_test);
[y_pred_nb_pca,  scores_nb_pca]  = predict(nb_model_pca,  X_test);

% Project & Predict with LDA
X_test_lda = X_test * lda_dirs;
[y_pred_knn_lda, scores_knn_lda] = predict(knn_model_lda, X_test_lda);
[y_pred_nb_lda,  scores_nb_lda] = predict(nb_model_lda,  X_test_lda);

%% Step 8: Compute Overall Accuracy
fprintf("Calculating Accuracy...\n");

% PCA
acc_knn = mean(y_pred_knn_pca == y_test);
acc_nb  = mean(y_pred_nb_pca  == y_test);
fprintf('KNN accuracy: %.2f%%\n', acc_knn*100);
fprintf('NB  accuracy: %.2f%%\n', acc_nb*100);

% LDA
acc_knn_f = mean(y_pred_knn_lda == y_test);
acc_nb_f  = mean(y_pred_nb_lda  == y_test);
fprintf('KNN + Fisherfaces acc: %.2f%%\n', acc_knn_f*100);
fprintf('NB  + Fisherfaces acc: %.2f%%\n', acc_nb_f*100);

%% Step 9: Confusion Matrices
fprintf("Creating Confusion Tables...\n");

% PCA
figure;
confusionchart(y_test, y_pred_knn_pca, 'RowSummary','row-normalized','ColumnSummary','column-normalized');
title('KNN Confusion Matrix');

figure;
confusionchart(y_test, y_pred_nb_pca, 'RowSummary','row-normalized','ColumnSummary','column-normalized');
title('NB Confusion Matrix');

% LDA
figure;
confusionchart(y_test, y_pred_knn_lda, 'RowSummary','row-normalized','ColumnSummary','column-normalized');
title('KNN + Fisherfaces Confusion Matrix');

figure;
confusionchart(y_test, y_pred_nb_lda,  'RowSummary','row-normalized','ColumnSummary','column-normalized');
title('NB + Fisherfaces Confusion Matrix');

%% Step 10: ROC Curve & FPR/TPR (One-vs-All Example)
class_idx = 3; % Pick an actor 1-5
pos_label  = (y_test == class_idx);

fprintf("Creating ROC Curve for %s...\n", unique_names{class_idx});

% PCA
[X_knn_pca, Y_knn_pca, ~, AUC_knn_pca] = perfcurve(pos_label, scores_knn_pca(:,class_idx), true); % KNN
[X_nb_pca,  Y_nb_pca,  ~, AUC_nb_pca] = perfcurve(pos_label, scores_nb_pca(:,class_idx),  true); % NB

figure; 
plot(X_knn_pca, Y_knn_pca, 'LineWidth',1.5); hold on
plot(X_nb_pca,  Y_nb_pca,  'LineWidth',1.5);
xlabel('False Positive Rate');
ylabel('True Positive Rate');
legend( sprintf('KNN (AUC=%.2f)', AUC_knn_pca), sprintf('NB  (AUC=%.2f)', AUC_nb_pca), 'Location','southeast' );
title(['ROC for class: ' unique_names{class_idx}], 'Interpreter','none');
grid on;

% LDA
[X_knn_lda, Y_knn_lda, ~, AUC_knn_lda] = perfcurve(pos_label, scores_knn_lda(:,class_idx), true); % KNN
[X_nb_lda, Y_nb_lda, ~, AUC_nb_lda] = perfcurve(pos_label, scores_nb_lda(:,class_idx),  true); % NB

figure; 
plot(X_knn_lda,Y_knn_lda,'LineWidth',1.5); hold on
plot(X_nb_lda, Y_nb_lda,'LineWidth',1.5);
xlabel('False Positive Rate'); ylabel('True Positive Rate');
legend(sprintf('KNN (AUC=%.2f)',AUC_knn_lda), sprintf('NB (AUC=%.2f)',AUC_nb_lda), 'Location','southeast');
title(['Fisherfaces ROC, class: ' unique_names{class_idx}],'Interpreter','none');
grid on;

%% Step 11: Display random examples
n_examples = 9; % how many examples to show
idx = randperm(num_test_images, n_examples);

figure('Name','Sample Test Predictions','NumberTitle','off');
for k = 1:n_examples
    i = idx(k);
    subplot(3,3,k);
      imshow(test_imgs{i});
      true_lbl = unique_names{y_test(i)};
      knn_lbl  = unique_names{y_pred_knn_pca(i)};
      nb_lbl   = unique_names{y_pred_nb_pca(i)};
      title(sprintf('True: %s\nKNN: %s  NB: %s', true_lbl, knn_lbl, nb_lbl), 'Interpreter','none','FontSize',10);
end

% Display random examples for LDA
n_examples = 9; idx = randperm(num_test_images, n_examples);
figure('Name','Fisherfaces Samples','NumberTitle','off');
for k=1:n_examples
  i = idx(k);
  subplot(3,3,k); imshow(test_imgs{i});
  title(sprintf('True:%s\nKNN:%s  NB:%s', ...
    unique_names{y_test(i)}, ...
    unique_names{y_pred_knn_lda(i)}, ...
    unique_names{y_pred_nb_lda(i)}), ...
    'Interpreter','none','FontSize',10);
end

%% Functions

% Preprocess Image Input
function img = PreprocessImage(input, need_crop)
    % Convert image to grayscale
    grey_img = im2gray(input);

    if(need_crop)
        % Use pretrained face detector
        detector = vision.CascadeObjectDetector();
        bound_box = step(detector, grey_img); % Each row: [x, y, w, h]
    
        % If no face is found, use entire image
        if isempty(bound_box)
            warning('No face detected, using the full image.');
            cropped_img = grey_img;
            
        % If multiple faces are found, pick the largest bounding box
        elseif size(bound_box, 1) > 1
            areas = bound_box(:, 3) .* bound_box(:, 4); % width * height
            [~, idx] = max(areas); % Choose the largest face
            cropped_img = imcrop(grey_img, bound_box(idx, :));
        else
            % Exactly one face
            cropped_img = imcrop(grey_img, bound_box);
        end

        % Resize the cropped image
        img = imresize(cropped_img, [100, 100]);
    else
        % Resize the image
        img = imresize(grey_img, [100, 100]);
    end
end

% PCA Eginefaces
function [mean_face, evecs_reduced, projected_data_pca, eigen_faces] = PCA_Eigenfaces(img_matrix, K)
    % 1) Mean face & Face centering
    mean_face = mean(img_matrix,1);
    faces_centered = img_matrix - mean_face;

    % Covariance & Eigendecomp
    C = faces_centered' * faces_centered / (size(faces_centered,1) - 1);
    [eigen_vectors, eigen_values] = eig(C, 'vector');
    [~, sort_index] = sort(eigen_values, 'descend');
    eigen_vectors = eigen_vectors(:, sort_index);

    eigen_faces = faces_centered * eigen_vectors;
    eigen_faces = eigen_faces ./ vecnorm(eigen_faces);

    % Reduced subspace
    fprintf("Reducing EigenFaces...\n");
    evecs_reduced  = eigen_vectors(:,1:K);
    projected_data_pca = faces_centered * evecs_reduced;
end

% LDA Fisherfaces after PCA to reduce dimensionality
function directions = compute_LDA_directions(projected_data_pca, labels)
    [~, feature_num] = size(projected_data_pca);
    classes = unique(labels);
    class_num = numel(classes);

    overall_mean  = mean(projected_data_pca,1);
    within_class = zeros(feature_num,feature_num); % Within-Class Scatter
    between_class = zeros(feature_num,feature_num); % Between-class scatter

    % Loop through each class to gather within and between class features
    for c=1:class_num
      index = (labels==classes(c));

      c_samples = projected_data_pca(index,:);
      class_mean = mean(c_samples,1);
      within_class = within_class + (c_samples - class_mean)'*(c_samples - class_mean);
      dmu = (class_mean - overall_mean)';
      between_class = between_class + sum(index)*(dmu*dmu'); % Weight by # of samples
    end

    [V,L] = eig(between_class, within_class);
    [~,ord] = sort(diag(L),'descend'); % Sort eigenvalues in descending
    directions = V(:, ord(1:class_num-1));
end
